{
  "name": "Adhan Detector",
  "short_name": "Adhan",
  "description": "Listens for the adhan around each prayer time and shows when it has been called. Works offline.",
  "start_url": "app.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#0f1412",
  "theme_color": "#165c3e",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
